#!/bin/sh
# Records how it was called, for event handlers and for looking at macros.
#
#   args <key> [-c <code>] <anything>...
#
# Adds "<ms since start> <key> <arguments joined by |>" to ../state/trace,
# prints "<key> called" and ends with <code>, or with 0.
set -u
dir=$(dirname "$0")/../state
key=$1
shift
code=0
if [ "${1:-}" = "-c" ]; then code=$2; shift 2; fi

line=
for arg in "$@"; do line="$line|$arg"; done
line=${line#|}

. "$dir/../plugins/trace.sh"
trace "$key" "$line"
echo "$key called"
exit "$code"
