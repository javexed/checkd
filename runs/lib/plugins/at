#!/bin/sh
# A scripted check plugin that follows the clock, for the differential runs.
#
#   at <key> <code> [<second>:<code>]...
#
# Gives the first code until the run is <second> seconds old, then the code
# written after it, and so on:
#
#   at gw 0 20:2 45:0        OK, CRITICAL from second 20, OK from second 45
#
# The start of the run is the time of ../state/start beside this script.
# Every call is added to ../state/trace as "<ms since start> <key> <code>".
set -u
dir=$(dirname "$0")/../state
key=$1
code=$2
shift 2

. "$dir/../plugins/trace.sh"
age=$(($(elapsed_ms) / 1000))
for step in "$@"; do
    [ "$age" -ge "${step%%:*}" ] && code=${step#*:}
done

trace "$key" "$code"
echo "$key is $code at second $age"
exit "$code"
