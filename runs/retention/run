#!/usr/bin/env bash
# The way back to Naemon, and in again: checkd is given a state (a hard
# CRITICAL, an acknowledgement, a comment, a downtime, notifications
# turned off by command), writes it as a retention.dat, the reference
# (oracle/play) starts from that file and saves its own at the end, and
# checkd reads that one into a new store. The two states must be the same.
#
#   runs/retention/run
#
# Needs Docker for the reference. Says "ok" or what differs, and ends
# with 1 when something does.
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd)
root=$(cd "$here/../.." && pwd)
cd "$root"
cargo build --quiet --release --locked -p checkd --bin checkd --example unixcat
checkd=target/release/checkd
unixcat=target/release/examples/unixcat
work=$(mktemp -d "${TMPDIR:-/tmp}/checkd-retention.XXXXXX")
trap 'kill "${pid:-}" 2>/dev/null || true; rm -rf "$work"' EXIT
mkdir -p "$work/case" "$work/run"
cp "$here/objects.cfg" "$work/case/"
cp "$here/objects.cfg" "$work/run/"
# No checks are run on either side: the state is what the commands make.
settings='cfg_file=objects.cfg
check_external_commands=1
execute_service_checks=0
execute_host_checks=0'
printf '%s\nretain_state_information=1\n' "$settings" > "$work/case/naemon.cfg"
printf '%s\nlog_file=%s/run/checkd.log\n' "$settings" "$work" > "$work/run/naemon.cfg"

socket="$work/live"
"$checkd" run --store "sqlite:$work/run/store.sqlite" --livestatus "$socket" "$work/run/naemon.cfg" > "$work/run/out" 2>&1 &
pid=$!
for _ in $(seq 50); do [ -S "$socket" ] && break; sleep 0.1; done
t=$(date +%s)
{
    printf 'COMMAND [%s] PROCESS_SERVICE_CHECK_RESULT;web;a;2;disk on fire\n' "$t"
    printf 'COMMAND [%s] ACKNOWLEDGE_SVC_PROBLEM;web;a;2;1;1;ann;on it\n' "$t"
    printf 'COMMAND [%s] ADD_HOST_COMMENT;web;1;bob;keep an eye on it\n' "$t"
    printf 'COMMAND [%s] SCHEDULE_SVC_DOWNTIME;web;b;%s;%s;1;0;3600;cy;patching\n' "$t" "$t" "$((t + 3600))"
    printf 'COMMAND [%s] DISABLE_SVC_NOTIFICATIONS;web;b\n\n' "$t"
} | "$unixcat" "$socket" > /dev/null
sleep 1
kill -TERM "$pid"; wait "$pid" || true; pid=

"$checkd" export-retention "sqlite:$work/run/store.sqlite" "$work/case/retention.dat" > /dev/null
oracle/play "$work/case" "$work/out" 3 > /dev/null
"$checkd" import-retention "$work/out/retention.dat" "sqlite:$work/back.sqlite" > /dev/null
"$checkd" state "sqlite:$work/run/store.sqlite" > "$work/first.txt"
"$checkd" state "sqlite:$work/back.sqlite" > "$work/back.txt"
if [ "$(grep -c . "$work/first.txt")" -lt 7 ]; then
    echo "checkd did not keep what the commands made:"; cat "$work/first.txt"; exit 1
fi
if diff -u "$work/first.txt" "$work/back.txt"; then
    echo ok
else
    echo "the state that came back from the reference differs"; exit 1
fi
