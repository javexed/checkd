#!/usr/bin/env bash
# Shows that checkd reads its configuration again without losing state.
#
#   runs/reload/run
#
# checkd runs on a small configuration, once with an SQLite store and
# once with none. The script (entry.sh, in the oracle image without a
# network) then:
#
#   1. submits a state, a comment and a downtime;
#   2. adds a host to the configuration and sends SIGHUP: both hosts are
#      there, with the state, the comment, the downtime and the log's
#      earlier lines, and the command file still takes commands;
#   3. breaks the configuration and sends SIGHUP: checkd says so and goes
#      on with the configuration it had;
#   4. mends it, takes the first host's service away, and sends
#      RESTART_PROGRAM through Livestatus: the service is gone, and so is
#      its comment.
#
# What the runs left stays in runs/reload-work/<store>.
set -euo pipefail

here=$(cd "$(dirname "$0")" && pwd)
root=$(cd "$here/../.." && pwd)
work=$root/runs/reload-work
core=$(sed -n 's/^ARG NAEMON_CORE_VERSION=//p' "$root/oracle/Dockerfile")
inputs=$(cat "$root/oracle/Dockerfile" "$root/oracle/entry.sh" | sha256sum | cut -c1-12)
image="checkd-oracle:naemon-${core}-${inputs}"
docker image inspect "$image" >/dev/null 2>&1 \
    || { echo "no oracle image; run oracle/run on any case first" >&2; exit 2; }

cd "$root"
cargo build --quiet -p checkd
failed=0
for store in sqlite none; do
    out=$work/$store
    rm -rf "$out"
    mkdir -p "$out"
    echo "== store: $store"
    docker run --rm --network none --user "$(id -u):$(id -g)" \
        -v "$here/entry.sh:/entry.sh:ro" -v "$root/target/debug/checkd:/checkd:ro" -v "$out:/out" \
        --entrypoint sh "$image" /entry.sh "$store" || failed=1
done
echo
if [ "$failed" = 0 ]; then
    echo "All reload checks passed."
else
    echo "Some reload checks failed. See $work."
    exit 1
fi
