
define timeperiod {
	timeperiod_name	always
	alias	Every hour of every day
	sunday	00:00-24:00
	monday	00:00-24:00
	tuesday	00:00-24:00
	wednesday	00:00-24:00
	thursday	00:00-24:00
	friday	00:00-24:00
	saturday	00:00-24:00
	}

define timeperiod {
	timeperiod_name	lunch
	alias	Lunch
	monday	12:00-13:00
	}

define timeperiod {
	timeperiod_name	office
	alias	Office hours
	exclude	lunch
	monday	09:00-17:00
	}

define command {
	command_name	check_dummy
	command_line	/usr/lib/checkd-test/check_dummy $ARG1$
	}

define command {
	command_name	notify_dummy
	command_line	/usr/lib/checkd-test/notify_dummy
	}

