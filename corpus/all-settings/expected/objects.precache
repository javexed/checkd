
define timeperiod {
	timeperiod_name	always
	alias	Every hour of every day
	sunday	00:00-24:00
	monday	00:00-24:00
	tuesday	00:00-24:00
	wednesday	00:00-24:00
	thursday	00:00-24:00
	friday	00:00-24:00
	saturday	00:00-24:00
	}

define timeperiod {
	timeperiod_name	workhours
	alias	Working hours
	monday	09:00-17:00
	}

define command {
	command_name	check_dummy
	command_line	/usr/lib/checkd-test/check_dummy $ARG1$
	}

define command {
	command_name	notify_dummy
	command_line	/usr/lib/checkd-test/notify_dummy
	}

define contactgroup {
	contactgroup_name	cg-admins
	alias	cg-admins
	members	ops,full
	}

define hostgroup {
	hostgroup_name	hg-full
	alias	hg-full
	members	full
	}

define servicegroup {
	servicegroup_name	sg-full
	alias	sg-full
	members	full,Every setting
	}

define contact {
	contact_name	full
	alias	Contact with every setting
	service_notification_period	always
	host_notification_period	workhours
	service_notification_options	r,w,u,c,f,s
	host_notification_options	r,d,u,f,s
	service_notification_commands	notify_dummy,check_dummy
	host_notification_commands	check_dummy,notify_dummy
	email	full@example.test
	pager	+1-555-0101
	address1	first
	address2	second
	address3	third
	address4	fourth
	address5	fifth
	address6	sixth
	minimum_value	4
	host_notifications_enabled	0
	service_notifications_enabled	0
	can_submit_commands	0
	retain_status_information	0
	retain_nonstatus_information	0
	_TEAM	platform
	}

define contact {
	contact_name	ops
	alias	ops
	service_notification_period	always
	host_notification_period	always
	service_notification_options	r,w,u,c
	host_notification_options	r,d,u
	service_notification_commands	notify_dummy
	host_notification_commands	notify_dummy
	minimum_value	1
	host_notifications_enabled	1
	service_notifications_enabled	1
	can_submit_commands	1
	retain_status_information	1
	retain_nonstatus_information	1
	}

define host {
	host_name	full
	display_name	Full host
	alias	Host with every setting
	address	192.0.2.10
	parents	upstream
	check_period	workhours
	check_command	check_dummy!1!two words
	event_handler	check_dummy!2
	contacts	ops
	contact_groups	cg-admins
	notification_period	workhours
	initial_state	o
	check_timeout	17
	hourly_value	7
	check_interval	2.500000
	retry_interval	0.500000
	max_check_attempts	9
	active_checks_enabled	0
	passive_checks_enabled	0
	obsess	0
	event_handler_enabled	0
	low_flap_threshold	12.500000
	high_flap_threshold	37.500000
	flap_detection_enabled	0
	flap_detection_options	o,d
	freshness_threshold	600
	check_freshness	1
	notification_options	r,d,u,f,s
	notifications_enabled	0
	notification_interval	90.000000
	first_notification_delay	15.000000
	stalking_options	o,d,u
	process_perf_data	0
	icon_image	server.png
	icon_image_alt	A server
	vrml_image	server.wrl
	statusmap_image	server.gd2
	2d_coords	120,45
	3d_coords	1.500000,2.500000,3.500000
	notes	Host notes
	notes_url	https://example.test/notes/$HOSTNAME$
	action_url	https://example.test/action/$HOSTNAME$
	retain_status_information	0
	retain_nonstatus_information	0
	_ASSET_TAG	A-0042
	}

