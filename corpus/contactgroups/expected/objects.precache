
define timeperiod {
	timeperiod_name	always
	alias	Every hour of every day
	sunday	00:00-24:00
	monday	00:00-24:00
	tuesday	00:00-24:00
	wednesday	00:00-24:00
	thursday	00:00-24:00
	friday	00:00-24:00
	saturday	00:00-24:00
	}

define command {
	command_name	check_dummy
	command_line	/usr/lib/checkd-test/check_dummy $ARG1$
	}

define command {
	command_name	notify_dummy
	command_line	/usr/lib/checkd-test/notify_dummy
	}

define contactgroup {
	contactgroup_name	cg-admins
	alias	Administrators
	members	dev,ops
	}

define contactgroup {
	contactgroup_name	cg-all
	alias	cg-all
	members	dev,manager,night,ops
	}

define contactgroup {
	contactgroup_name	cg-by-contact
	alias	cg-by-contact
	members	manager
	}

define contactgroup {
	contactgroup_name	cg-empty
	alias	cg-empty
	}

define contactgroup {
	contactgroup_name	cg-escalation
	alias	cg-escalation
	members	night,manager,ops,dev
	}

define contactgroup {
	contactgroup_name	cg-top
	alias	cg-top
	members	dev,ops,manager,night
	}

define contact {
	contact_name	dev
	alias	Developer on duty
	service_notification_period	always
	host_notification_period	always
	service_notification_options	r,w,u,c
	host_notification_options	r,d,u
	service_notification_commands	notify_dummy
	host_notification_commands	notify_dummy
	email	dev@example.test
	address1	dev-chat
	address6	dev-backup
	minimum_value	1
	host_notifications_enabled	1
	service_notifications_enabled	1
	can_submit_commands	1
	retain_status_information	1
	retain_nonstatus_information	1
	}

define contact {
	contact_name	manager
	alias	manager
	service_notification_period	always
	host_notification_period	always
	service_notification_options	r,w,u,c
	host_notification_options	r,d,u
	service_notification_commands	notify_dummy
	host_notification_commands	notify_dummy
	minimum_value	1
	host_notifications_enabled	1
	service_notifications_enabled	1
	can_submit_commands	1
	retain_status_information	1
	retain_nonstatus_information	1
	}

define contact {
	contact_name	night
	alias	night
	service_notification_period	always
	host_notification_period	always
	service_notification_options	f,s
	host_notification_options	n
	service_notification_commands	notify_dummy
	host_notification_commands	notify_dummy
	minimum_value	5
	host_notifications_enabled	0
	service_notifications_enabled	0
	can_submit_commands	0
	retain_status_information	0
	retain_nonstatus_information	0
	}

define contact {
	contact_name	ops
	alias	ops
	service_notification_period	always
	host_notification_period	always
	service_notification_options	r,w,u,c
	host_notification_options	r,d,u
	service_notification_commands	notify_dummy
	host_notification_commands	notify_dummy
	minimum_value	1
	host_notifications_enabled	1
	service_notifications_enabled	1
	can_submit_commands	1
	retain_status_information	1
	retain_nonstatus_information	1
	}

define host {
	host_name	alpha
	alias	alpha
	address	192.0.2.10
	check_period	always
	check_command	check_dummy!0
	contacts	ops
	contact_groups	cg-empty,cg-top
	notification_period	always
	initial_state	o
	check_timeout	30
	hourly_value	1
	check_interval	5.000000
	retry_interval	1.000000
	max_check_attempts	3
	active_checks_enabled	1
	passive_checks_enabled	1
	obsess	1
	event_handler_enabled	1
	low_flap_threshold	0.000000
	high_flap_threshold	0.000000
	flap_detection_enabled	1
	flap_detection_options	a
	freshness_threshold	0
	check_freshness	0
	notification_options	a
	notifications_enabled	1
	notification_interval	30.000000
	first_notification_delay	0.000000
	stalking_options	n
	process_perf_data	1
	retain_status_information	1
	retain_nonstatus_information	1
	}

define host {
	host_name	beta
	alias	beta
	address	192.0.2.11
	check_period	always
