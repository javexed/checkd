
define timeperiod {
	timeperiod_name	always
	alias	Every hour of every day
	sunday	00:00-24:00
	monday	00:00-24:00
	tuesday	00:00-24:00
	wednesday	00:00-24:00
	thursday	00:00-24:00
	friday	00:00-24:00
	saturday	00:00-24:00
	}

define command {
	command_name	check_dummy
	command_line	/usr/lib/checkd-test/check_dummy $ARG1$
	}

define command {
	command_name	notify_dummy
	command_line	/usr/lib/checkd-test/notify_dummy
	}

define hostgroup {
	hostgroup_name	hg-db
	alias	hg-db
	members	db-1,db-2
	}

define hostgroup {
	hostgroup_name	hg-first-of-each
	alias	hg-first-of-each
	members	db-1,web-1
	}

define hostgroup {
	hostgroup_name	hg-web
	alias	hg-web
	members	web-1,web-10,web-2
	}

define servicegroup {
	servicegroup_name	sg-stars
	alias	sg-stars
	members	web-10,Unanchored,web-1,Pattern minus one,web-2,Pattern minus one,web-1,Group pattern,web-2,Group pattern,web-10,Group pattern,web-1,Unanchored,web-1,Question mark,web-2,Question mark,web-10,Question mark,web-1,Star suffix,web-2,Star suffix,web-10,Star suffix
	}

define contact {
	contact_name	ops
	alias	ops
	service_notification_period	always
	host_notification_period	always
	service_notification_options	r,w,u,c
	host_notification_options	r,d,u
	service_notification_commands	notify_dummy
	host_notification_commands	notify_dummy
	minimum_value	1
	host_notifications_enabled	1
	service_notifications_enabled	1
	can_submit_commands	1
	retain_status_information	1
	retain_nonstatus_information	1
	}

define host {
	host_name	db-1
	alias	db-1
	address	192.0.2.13
	check_period	always
	check_command	check_dummy!0
	contacts	ops
	notification_period	always
	initial_state	o
	check_timeout	30
	hourly_value	1
	check_interval	5.000000
	retry_interval	1.000000
	max_check_attempts	3
	active_checks_enabled	1
	passive_checks_enabled	1
	obsess	1
	event_handler_enabled	1
	low_flap_threshold	0.000000
	high_flap_threshold	0.000000
	flap_detection_enabled	1
	flap_detection_options	a
	freshness_threshold	0
	check_freshness	0
	notification_options	a
	notifications_enabled	1
	notification_interval	30.000000
	first_notification_delay	0.000000
	stalking_options	n
	process_perf_data	1
	retain_status_information	1
	retain_nonstatus_information	1
	}

